# Optional migration: set this BEFORE [google_oauth] only if the signed-in account owns the old root folder.
# legacy_gallery_folder_id = "YOUR_OLD_GALLERY_FOLDER_ID"

[google_oauth]
client_id = "YOUR_GOOGLE_OAUTH_CLIENT_ID"
client_secret = "YOUR_GOOGLE_OAUTH_CLIENT_SECRET"
redirect_uri = "https://app-app-drive-gallery-gokul.streamlit.app"
